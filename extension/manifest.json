{
  "manifest_version": 3,
  "name": "Privacy & Terms Guardian",
  "version": "0.1.0",
  "description": "A personal privacy agent for the web — analyses policies, protects your cookies, and finds better alternatives.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy & Terms Guardian"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
